# 签名配置模板 —— 复制为 key.properties 后填入真实值
# 注意：key.properties 已被 .gitignore 忽略，不会提交到仓库，请妥善备份！
#
# 生成密钥库命令（在项目根目录执行，有效期 ~27 年）：
#   keytool -genkey -v -keystore android/app/fangdai-release.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias fangdai
#
storePassword=你的密钥库密码
keyPassword=你的密钥密码
keyAlias=fangdai
# storeFile 相对 android/app 目录；若放在 app 目录下直接写文件名即可
storeFile=fangdai-release.jks
